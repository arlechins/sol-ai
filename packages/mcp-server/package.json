{
  "name": "@taopp/mcp-server",
  "version": "0.2.0",
  "description": "MCP server that lets any agent vet other agents on Solana: reputation scores, capability discovery, attestations, and bonded challenges",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taopp-mcp-server": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arlechins/sol-ai.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/arlechins/sol-ai#readme",
  "bugs": {
    "url": "https://github.com/arlechins/sol-ai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/web3.js": "^1.99.0",
    "@taopp/solana": "workspace:*",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
