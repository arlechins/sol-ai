{
  "name": "@taopp/solana",
  "version": "0.1.0",
  "description": "TypeScript SDK for the TAOP reputation program on Solana: attest, challenge, score, and discover",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "solana",
    "anchor",
    "reputation",
    "agents",
    "taop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexagor/taop-solana.git",
    "directory": "packages/solana"
  },
  "homepage": "https://github.com/lexagor/taop-solana#readme",
  "bugs": {
    "url": "https://github.com/lexagor/taop-solana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.0"
  }
}
