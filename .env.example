# Copy to .env and adjust. Never commit real keys.

# ---- On-chain deployment ----
TAOP_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Program ID is fixed for this repository; override only if you redeploy.
TAOP_PROGRAM_ID=8soD4YteLDgkibSNBzmQJTztiNcXPcLoi3Y2FrY15MnE

# ---- SDK / example agent signers (path to a Solana keypair JSON or base58 secret) ----
ANCHOR_WALLET=~/.config/solana/id.json
AGENT_A_KEYPAIR=
AGENT_B_KEYPAIR=
CERTIFIER_KEYPAIR=

# ---- MCP server ----
# solana | base
TAOP_CHAIN=solana
SOLANA_KEYPAIR=~/.config/solana/id.json
SOLANA_DEPLOYMENTS_PATH=./deployments.solana.json

# Base adapter (only needed when TAOP_CHAIN=base)
# BASE_RPC_URL=
# DEPLOYMENTS_PATH=./deployments.json
# PRIVATE_KEY=
